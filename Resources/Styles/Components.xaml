<?xml version="1.0" encoding="UTF-8" ?>
<!--
    SHARED COMPONENTS
    =================
    Composed entirely from the token dictionaries. Screens should reach for a
    style here first and only write bespoke XAML when nothing fits — that is
    what stops each new module from inventing its own card.

    Every interactive style carries MinimumHeightRequest = TouchTarget so the
    44pt floor is inherited rather than remembered per screen.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Elevation ─────────────────────────────────────────────────────── -->
    <!-- Deliberately subtle: this app is read outdoors in direct sun, where a
         heavy shadow either disappears (too light) or reads as a smudge (too
         dark). Low opacity + soft radius gives cards a lifted, contemporary
         edge without competing with the WCAG-checked ink colors that do the
         actual contrast work. -->
    <Shadow x:Key="CardShadow" Brush="{StaticResource ColorTextPrimary}" Opacity="0.08" Radius="14" Offset="0,4" />
    <Shadow x:Key="ButtonShadow" Brush="{StaticResource ColorAccent}" Opacity="0.28" Radius="10" Offset="0,3" />

    <!-- ── Cards ─────────────────────────────────────────────────────────── -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="Stroke" Value="{StaticResource ColorBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- Tappable list row. Same look as Card, plus the touch floor. -->
    <Style x:Key="CardRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="Stroke" Value="{StaticResource ColorBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource CardMargin}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- ── Status badges ─────────────────────────────────────────────────── -->
    <!-- Base carries shape + the touch-irrelevant sizing; the four variants
         below differ only in the ink/tint pair, so status color stays
         consistent everywhere it appears. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="BadgeNeutral" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorNeutralTint}" />
    </Style>
    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSuccessTint}" />
    </Style>
    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorWarningTint}" />
    </Style>
    <Style x:Key="BadgeDanger" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorDangerTint}" />
    </Style>

    <Style x:Key="BadgeLabel" TargetType="Label">
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- ── Buttons ───────────────────────────────────────────────────────── -->
    <!-- One primary per screen or section, per the brief. -->
    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextOnAccent}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Shadow" Value="{StaticResource ButtonShadow}" />
        <!-- A custom BackgroundColor overrides MAUI's default disabled
             appearance, so a disabled button would otherwise look identical to
             an enabled one. -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ColorBorderStrong}" />
                            <Setter Property="TextColor" Value="{StaticResource ColorSurface}" />
                            <Setter Property="Shadow" Value="{x:Null}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="BorderColor" Value="{StaticResource ColorBorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Text-weight action, e.g. "See all". Still a full 44pt target. -->
    <Style x:Key="ButtonLink" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="ButtonDangerQuiet" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorDanger}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- ── Form controls ─────────────────────────────────────────────────── -->
    <Style x:Key="FormEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorTextTertiary}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="FormEditor" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorTextTertiary}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="88" />
    </Style>

    <Style x:Key="FormPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource ColorTextTertiary}" />
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="FormFieldLabel" TargetType="Label">
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
    </Style>

    <!-- ── Filter chip ───────────────────────────────────────────────────── -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="Stroke" Value="{StaticResource ColorBorderStrong}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="ChipSelected" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccentTint}" />
        <Setter Property="Stroke" Value="{StaticResource ColorAccent}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontAutoScalingEnabled" Value="True" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ChipLabelSelected" TargetType="Label" BasedOn="{StaticResource ChipLabel}">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
    </Style>

</ResourceDictionary>
