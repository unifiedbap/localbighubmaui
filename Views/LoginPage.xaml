<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BigLocalHub.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BigLocalHub.ViewModels"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource ColorPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="{StaticResource Space4}" VerticalOptions="Center">

            <Label Text="Big Local Hub" Style="{StaticResource TextDisplay}" HorizontalOptions="Center" />
            <Label
                Text="Sign in to your company workspace"
                Style="{StaticResource TextMuted}"
                HorizontalOptions="Center"
                Margin="0,0,0,8" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource Space4}">

                    <VerticalStackLayout Spacing="{StaticResource Space1}">
                        <Label Text="EMAIL" Style="{StaticResource FormFieldLabel}" />
                        <Entry
                            Text="{Binding Email}"
                            Keyboard="Email"
                            IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                            Placeholder="you@company.com"
                            Style="{StaticResource FormEntry}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource Space1}">
                        <Label Text="PASSWORD" Style="{StaticResource FormFieldLabel}" />
                        <Entry
                            Text="{Binding Password}"
                            IsPassword="True"
                            IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}"
                            Placeholder="Your password"
                            ReturnType="Go"
                            ReturnCommand="{Binding SignInCommand}"
                            Style="{StaticResource FormEntry}" />
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmpty}}"
                        BackgroundColor="{StaticResource ColorDangerTint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="{StaticResource Space3}">
                        <Label Text="{Binding Error}" TextColor="{StaticResource ColorDanger}" />
                    </Border>

                    <Button
                        Text="Sign In"
                        Command="{Binding SignInCommand}"
                        IsVisible="{Binding Busy, Converter={StaticResource InverseBool}}"
                        Style="{StaticResource ButtonPrimary}" />

                    <ActivityIndicator
                        IsVisible="{Binding Busy}"
                        IsRunning="{Binding Busy}"
                        Color="{StaticResource ColorAccent}"
                        HeightRequest="50" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
