<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BigLocalHub.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BigLocalHub.ViewModels"
    x:DataType="vm:CalendarViewModel"
    Title="Calendar"
    BackgroundColor="{StaticResource ColorPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource Space5}">

            <Border IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmpty}}"
                    BackgroundColor="{StaticResource ColorDangerTint}" Stroke="{StaticResource ColorDanger}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="{StaticResource Space3}">
                <Label Text="{Binding Error}" TextColor="{StaticResource ColorDanger}" />
            </Border>

            <!-- ── Upcoming ───────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="UPCOMING" Style="{StaticResource TextSectionLabel}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding RangeSummary}" Style="{StaticResource TextSectionLabel}"
                           TextColor="{StaticResource ColorTextTertiary}" VerticalOptions="Center" />
                </Grid>

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}">
                    <VerticalStackLayout Spacing="{StaticResource Space1}">
                        <Label Text="Nothing scheduled" Style="{StaticResource TextCardPrimary}" />
                        <Label Text="Jobs with a quote date or start date show up here." Style="{StaticResource TextCardSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="{StaticResource Space4}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarDayGroup">
                            <VerticalStackLayout Spacing="{StaticResource Space2}">
                                <Label Text="{Binding Header}" Style="{StaticResource TextHeading}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Events}" Spacing="{StaticResource Space2}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarRow">
                                            <Border Style="{StaticResource Card}" MinimumHeightRequest="{StaticResource TouchTarget}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="{StaticResource Space1}">
                                                        <Label Text="{Binding Title}" Style="{StaticResource TextCardPrimary}" />
                                                        <Label Text="{Binding Location}" Style="{StaticResource TextCardSecondary}"
                                                               IsVisible="{Binding HasLocation}" />
                                                    </VerticalStackLayout>
                                                    <Border Grid.Column="1" BackgroundColor="{StaticResource ColorAccentTint}" StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8" Padding="10,5" VerticalOptions="Center">
                                                        <Label Text="{Binding TimeLabel}" Style="{StaticResource BadgeLabel}" TextColor="{StaticResource ColorAccent}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── External calendars ─────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}">
                <Label Text="SYNC TO YOUR CALENDAR" Style="{StaticResource TextSectionLabel}" />
                <Label Text="Pushes upcoming jobs and quote appointments out. Past work isn't sent."
                       Style="{StaticResource TextCardSecondary}" TextColor="{StaticResource ColorTextTertiary}" />

                <Border IsVisible="{Binding SyncMessage, Converter={StaticResource IsNotNullOrEmpty}}"
                        BackgroundColor="{StaticResource ColorAccentTint}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" Padding="{StaticResource Space3}">
                    <Label Text="{Binding SyncMessage}" TextColor="{StaticResource ColorAccent}" />
                </Border>

                <ActivityIndicator IsVisible="{Binding Syncing}" IsRunning="{Binding Syncing}"
                                   Color="{StaticResource ColorAccent}" HeightRequest="44" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Bridges}" Spacing="{StaticResource Space3}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BridgeRow">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="{StaticResource Space3}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                                        <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space1}">
                                            <Label Text="{Binding Name}" Style="{StaticResource TextCardPrimary}" />
                                            <Label Text="{Binding Description}" Style="{StaticResource TextCardSecondary}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{Binding StatusTint}" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8" Padding="10,5" VerticalOptions="Start">
                                            <Label Text="{Binding Status}" Style="{StaticResource BadgeLabel}" TextColor="{Binding StatusInk}" />
                                        </Border>
                                    </Grid>
                                    <Button Text="{Binding ActionLabel}"
                                            IsEnabled="{Binding CanAct}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalendarViewModel}}, Path=SyncCommand}"
                                            CommandParameter="{Binding Name}"
                                            Style="{StaticResource ButtonSecondary}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="72" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
