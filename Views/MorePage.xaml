<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BigLocalHub.Views.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BigLocalHub.ViewModels"
    x:DataType="vm:MoreViewModel"
    Title="More"
    BackgroundColor="{StaticResource ColorPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource Space6}">

            <!-- ── Account ────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space4}">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{StaticResource ColorAccentTint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        WidthRequest="56"
                        HeightRequest="56"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding Initials}"
                            Style="{StaticResource TextHeading}"
                            TextColor="{StaticResource ColorAccent}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="{StaticResource Space1}">
                        <Label Text="{Binding UserName}" Style="{StaticResource TextHeading}" />
                        <Label Text="{Binding UserEmail}" Style="{StaticResource TextCardSecondary}" />
                        <Label Text="{Binding CompanyName}" Style="{StaticResource TextCardSecondary}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ── Module launcher ────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}">
                <Label Text="ALL MODULES" Style="{StaticResource TextSectionLabel}" />

                <!-- Icon + label tiles. Three columns keeps each tile well past
                     the 44pt touch floor on the narrowest supported phone. -->
                <FlexLayout
                    BindableLayout.ItemsSource="{Binding Tiles}"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleTile">
                            <Border
                                Style="{StaticResource Card}"
                                WidthRequest="104"
                                MinimumHeightRequest="104"
                                Margin="0,0,10,10"
                                Padding="{StaticResource Space2}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MoreViewModel}}, Path=OpenModuleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="{StaticResource Space2}" VerticalOptions="Center">
                                    <Image
                                        Source="{Binding Icon}"
                                        WidthRequest="30"
                                        HeightRequest="30"
                                        HorizontalOptions="Center" />
                                    <Label
                                        Text="{Binding Label}"
                                        TextColor="{Binding LabelColor}"
                                        FontSize="{StaticResource FontLabel}"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="WordWrap" />
                                    <Label
                                        Text="{Binding Note}"
                                        IsVisible="{Binding Note, Converter={StaticResource IsNotNullOrEmpty}}"
                                        TextColor="{StaticResource ColorTextTertiary}"
                                        FontSize="{StaticResource FontLabel}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <!-- ── Settings detail ────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}">
                <Label Text="WORKSPACE" Style="{StaticResource TextSectionLabel}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="{StaticResource Space3}">
                        <Grid ColumnDefinitions="120,*">
                            <Label Grid.Column="0" Text="Role" Style="{StaticResource TextCardSecondary}" />
                            <Label Grid.Column="1" Text="{Binding RoleLabel}" Style="{StaticResource TextBody}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <Label Grid.Column="0" Text="Pipeline" Style="{StaticResource TextCardSecondary}" />
                            <Label Grid.Column="1" Text="{Binding PipelineStyle}" Style="{StaticResource TextBody}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ── Manager tools ──────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsManager}">
                <Label Text="MANAGER" Style="{StaticResource TextSectionLabel}" />

                <Border Style="{StaticResource Card}" MinimumHeightRequest="{StaticResource TouchTarget}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenTeamCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space1}">
                            <Label Text="Manage Team" Style="{StaticResource TextCardPrimary}" />
                            <Label Text="Link logins to crew members so they can clock in"
                                   Style="{StaticResource TextCaption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="{StaticResource FontTitle}"
                               TextColor="{StaticResource ColorAccent}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" MinimumHeightRequest="{StaticResource TouchTarget}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSeoHealthCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space1}">
                            <Label Text="SEO Health" Style="{StaticResource TextCardPrimary}" />
                            <Label Text="Your site's SEO score and what would help most"
                                   Style="{StaticResource TextCaption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="{StaticResource FontTitle}"
                               TextColor="{StaticResource ColorAccent}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- One primary action for this screen -->
            <Button Text="Sign Out" Command="{Binding SignOutCommand}" Style="{StaticResource ButtonSecondary}" />

            <!-- Clearance for the floating iOS tab bar, which overlays page content -->
            <BoxView HeightRequest="72" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
