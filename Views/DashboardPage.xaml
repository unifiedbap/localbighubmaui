<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Dashboard — reference implementation of the design system.
    Every color, size, and spacing value below comes from a token; there are no
    inline hex values or magic numbers. Use this file as the pattern when
    porting Leads, Jobs, Time, Expenses, and Portal.
-->
<ContentPage
    x:Class="BigLocalHub.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BigLocalHub.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="{StaticResource ColorPageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource Space6}">

            <!-- ── Header ─────────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="{Binding Greeting}" Style="{StaticResource TextMuted}" />
                <Label Text="{Binding CompanyName}" Style="{StaticResource TextDisplay}" />
            </VerticalStackLayout>

            <!-- Demo sandbox notice -->
            <Border
                IsVisible="{Binding IsDemo}"
                BackgroundColor="{StaticResource ColorAccentTint}"
                Stroke="{StaticResource ColorAccent}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="{StaticResource Space3}">
                <Label
                    Text="Live demo — explore freely. This sandbox resets every night."
                    TextColor="{StaticResource ColorAccent}"
                    FontAttributes="Bold" />
            </Border>

            <!-- Error -->
            <Border
                IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmpty}}"
                BackgroundColor="{StaticResource ColorDangerTint}"
                Stroke="{StaticResource ColorDanger}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="{StaticResource Space3}">
                <Label Text="{Binding Error}" TextColor="{StaticResource ColorDanger}" />
            </Border>

            <ActivityIndicator
                IsVisible="{Binding IsLoading}"
                IsRunning="{Binding IsLoading}"
                Color="{StaticResource ColorAccent}"
                HeightRequest="44" />

            <!-- ── NEEDS ACTION — the three-second answer ─────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsLoading, Converter={StaticResource InverseBool}}">

                <Label Text="NEEDS ACTION" Style="{StaticResource TextSectionLabel}" />

                <!-- All clear -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding AllCaughtUp}">
                    <HorizontalStackLayout Spacing="{StaticResource Space3}">
                        <Border
                            BackgroundColor="{StaticResource ColorSuccessTint}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44"
                            HeightRequest="44">
                            <Label
                                Text="✓"
                                FontSize="{StaticResource FontTitle}"
                                FontAttributes="Bold"
                                TextColor="{StaticResource ColorSuccess}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="{StaticResource Space1}">
                            <Label Text="You're all caught up" Style="{StaticResource TextCardPrimary}" />
                            <Label Text="Nothing needs attention right now" Style="{StaticResource TextCardSecondary}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Action rows. Whole row is the tap target, not a small chevron. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding NeedsAction}" Spacing="{StaticResource Space3}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionItem">
                            <Border Style="{StaticResource Card}" MinimumHeightRequest="{StaticResource TouchTarget}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenLeadsFilteredCommand}"
                                        CommandParameter="{Binding TargetStatus}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                                    <!-- Count chip carries the status color -->
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="{Binding Tint}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        MinimumWidthRequest="48"
                                        MinimumHeightRequest="48"
                                        Padding="{StaticResource Space2}"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding CountText}"
                                            FontSize="{StaticResource FontTitle}"
                                            FontAttributes="Bold"
                                            TextColor="{Binding Ink}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="{StaticResource Space1}">
                                        <Label Text="{Binding Title}" Style="{StaticResource TextCardPrimary}" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource TextCardSecondary}" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="2"
                                        Text="›"
                                        FontSize="{StaticResource FontTitle}"
                                        TextColor="{StaticResource ColorTextTertiary}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── Quick Actions — user-customizable shortcuts ────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="QUICK ACTIONS" Style="{StaticResource TextSectionLabel}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Edit" Command="{Binding ToggleCustomizingCommand}"
                            IsVisible="{Binding IsCustomizing, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource ButtonLink}" />
                    <Button Grid.Column="1" Text="Done" Command="{Binding ToggleCustomizingCommand}"
                            IsVisible="{Binding IsCustomizing}"
                            Style="{StaticResource ButtonLink}" />
                </Grid>

                <!-- Normal state: four big icon + label targets -->
                <Grid IsVisible="{Binding IsCustomizing, Converter={StaticResource InverseBool}}">
                    <FlexLayout BindableLayout.ItemsSource="{Binding QuickActions}" Wrap="Wrap" JustifyContent="SpaceBetween">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickAction">
                                <Border Style="{StaticResource Card}" WidthRequest="168" MinimumHeightRequest="96" Margin="0,0,0,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=OpenQuickActionCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="{StaticResource Space2}" VerticalOptions="Center">
                                        <Image Source="{Binding Icon}" WidthRequest="30" HeightRequest="30" HorizontalOptions="Start" />
                                        <Label Text="{Binding Label}" Style="{StaticResource TextCardPrimary}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </Grid>

                <!-- Edit state: pick which modules occupy the four slots -->
                <VerticalStackLayout IsVisible="{Binding IsCustomizing}" Spacing="{StaticResource Space3}">
                    <Label Text="{Binding CustomizeHint}" Style="{StaticResource TextCardSecondary}" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding QuickActionChoices}" Wrap="Wrap" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickActionChoice">
                                <Border BackgroundColor="{Binding Background}" Stroke="{Binding BorderColor}"
                                        StrokeThickness="1.5" StrokeShape="RoundRectangle 12"
                                        Padding="{StaticResource Space3}" Margin="0,0,10,10"
                                        WidthRequest="104" MinimumHeightRequest="96">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=ToggleQuickActionCommand}"
                                            CommandParameter="{Binding Key}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="{StaticResource Space2}" VerticalOptions="Center">
                                        <Image Source="{Binding Icon}" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" />
                                        <Label Text="{Binding Label}" TextColor="{Binding TextColor}"
                                               FontSize="{StaticResource FontLabel}" FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Button Text="Reset to default" Command="{Binding ResetQuickActionsCommand}" Style="{StaticResource ButtonSecondary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── Overview counts ────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                <Label Text="OVERVIEW" Style="{StaticResource TextSectionLabel}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space3}">
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{Binding OpenLeads}" Style="{StaticResource TextDisplay}" TextColor="{StaticResource ColorAccent}" />
                            <Label Text="Open leads" Style="{StaticResource TextCardSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="{StaticResource Space1}">
                            <Label Text="{Binding ActiveJobs}" Style="{StaticResource TextDisplay}" TextColor="{StaticResource ColorAccent}" />
                            <Label Text="Active jobs" Style="{StaticResource TextCardSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- ── Recent leads ───────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="RECENT LEADS" Style="{StaticResource TextSectionLabel}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="See all" Command="{Binding OpenLeadsCommand}" Style="{StaticResource ButtonLink}" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentLeads}" Spacing="{StaticResource Space3}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeadRow">
                            <Border Style="{StaticResource Card}" MinimumHeightRequest="{StaticResource TouchTarget}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="{StaticResource Space1}">
                                        <Label Text="{Binding Name}" Style="{StaticResource TextCardPrimary}" />
                                        <Label Text="{Binding ServiceType}" Style="{StaticResource TextCardSecondary}" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1" BackgroundColor="{Binding StatusTint}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                            Padding="10,5" VerticalOptions="Center">
                                        <Label Text="{Binding StatusLabel}" Style="{StaticResource BadgeLabel}" TextColor="{Binding StatusInk}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label
                    Text="No leads yet."
                    Style="{StaticResource TextMuted}"
                    IsVisible="{Binding RecentLeads.Count, Converter={StaticResource IsZero}}" />
            </VerticalStackLayout>

            <!-- Clearance for the floating iOS tab bar, which overlays page content -->
            <BoxView HeightRequest="72" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
