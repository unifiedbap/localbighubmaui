<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Big Local Hub adds your upcoming jobs and quote appointments to your calendar.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Big Local Hub adds your upcoming jobs and quote appointments to your calendar, and checks for ones it already added so it doesn't create duplicates.</string>
	<!-- App.xaml.cs sets UserAppTheme = AppTheme.Light, but that only
	     controls which AppThemeBinding values MAUI's own XAML resolves to —
	     it does not force native, system-rendered chrome into light mode.
	     Without this key, a device/simulator in Dark Mode still renders
	     native materials that don't go through AppThemeBinding (e.g. the
	     blur/vibrancy backdrop behind iOS 18's floating tab bar) dark,
	     regardless of any BackgroundColor set in C# — which is the likely
	     real cause of a black bar behind the tab bar that two different
	     UIWindow.BackgroundColor fixes both failed to change. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
