<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Tabs are built in code (AppShell.xaml.cs) rather than declared here,
    because which modules a company gets is data — company.enabledModules —
    not a compile-time decision.

    Chrome colors come from the design tokens so the tab bar matches the pages
    it sits under.
-->
<Shell
    x:Class="BigLocalHub.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BigLocalHub"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource ColorSurface}"
    Shell.TabBarForegroundColor="{StaticResource ColorAccent}"
    Shell.TabBarUnselectedColor="{StaticResource ColorTextSecondary}"
    Shell.TabBarTitleColor="{StaticResource ColorAccent}"
    Shell.BackgroundColor="{StaticResource ColorSurface}"
    Shell.ForegroundColor="{StaticResource ColorTextPrimary}"
    Shell.TitleColor="{StaticResource ColorTextPrimary}" />
