<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BigLocalHub"
             x:Class="BigLocalHub.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MAUI template baseline: provides Shell/NavigationPage/page
                     chrome styles. Kept because Styles.xaml references keys
                     from Colors.xaml — pull one and the other breaks. -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

                <!-- Design tokens. Order matters: Typography and Components
                     resolve color keys from Tokens/Colors.xaml, so it loads
                     first. Merged after the template so our implicit Label
                     style and control styles win. -->
                <ResourceDictionary Source="Resources/Styles/Tokens/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Tokens/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Tokens/Spacing.xaml" />
                <ResourceDictionary Source="Resources/Styles/Components.xaml" />
                <ResourceDictionary Source="Resources/Styles/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
